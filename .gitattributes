# 统一换行与文本处理，避免 Windows / macOS / Linux 协作时整文件 diff
* text=auto

*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.ps1      text eol=crlf

# Windows 批处理必须 CRLF，否则某些环境 cmd.exe 解析异常
*.cmd      text eol=crlf

# 二进制文件不做文本转换、不参与 diff
*.tgz      binary
*.gz       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.woff     binary
*.woff2    binary
