{
  "name": "npm-private-mirror-offline",
  "version": "0.0.1",
  "private": true,
  "description": "零依赖、可离线迁移的私人 npm 镜像源：本地缓存 + 私有包仓库 + 中文可视化管理界面",
  "keywords": [
    "npm",
    "registry",
    "mirror",
    "private-registry",
    "offline",
    "cache",
    "npm-mirror"
  ],
  "author": "苏离月 (SuLiyue)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/SuLiyue-s/npm-mirror.git"
  },
  "bugs": {
    "url": "https://github.com/SuLiyue-s/npm-mirror/issues"
  },
  "homepage": "https://github.com/SuLiyue-s/npm-mirror#readme",
  "main": "src/server.js",
  "bin": {
    "npm-mirror": "cli.js"
  },
  "scripts": {
    "start": "node cli.js start",
    "status": "node cli.js status",
    "stop": "node cli.js stop",
    "test": "node test/run-all.js",
    "test:path": "node test/desktop-path-test.js",
    "ver": "node tools/version.js",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-desktop.ps1",
    "release:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/release.ps1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {},
  "devDependencies": {}
}
